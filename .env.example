# Copy to .env only when ready. No credentials are required for fixture mode.
# This server never reads wallet files, browser state, or external credential files.
KILN_API_KEY=
KILN_BASE_URL=https://api.bricksum.com/v1
KILN_MODEL=qwen3-32b
# Includes reasoning tokens. Integer from 256 through 8192.
KILN_MAX_TOKENS=4096

# Optional evidence digest anchoring ONLY; no USDC payment is implemented.
# Leave disabled until you intentionally configure a disposable testnet account.
ENABLE_TESTNET_ANCHOR=false
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
TESTNET_PRIVATE_KEY=
